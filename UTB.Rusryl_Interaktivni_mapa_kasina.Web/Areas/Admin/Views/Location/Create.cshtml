@using UTB.Rusryl_Interaktivni_mapa_kasina.Domain.Entities
@model Location

@{
    ViewData["Title"] = "Create New Location";
}
<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <span asp-validation-summary="All" class="text-danger"></span>
    <div class="mb-3">
        <label class="form-label" asp-for="Name"></label>
        <input class="form-control" asp-for="Name">
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Address"></label>
        <input class="form-control" asp-for="Address">
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="ImageSrc"></label>
        <input class="form-control" asp-for="ImageSrc">
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Longitude"></label>
        <input class="form-control" asp-for="Longitude">
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Latitude"></label>
        <input class="form-control" asp-for="Latitude">
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="LocationTypeId"></label>
        <input class="form-control" asp-for="LocationTypeId">
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="LocationKindId"></label>
        <input class="form-control" asp-for="LocationKindId">
    </div>
    <button type="submit" class="btn btn-success">Submit</button>
    <a asp-action="PinManagement" class="btn btn-danger">Cancel</a>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}