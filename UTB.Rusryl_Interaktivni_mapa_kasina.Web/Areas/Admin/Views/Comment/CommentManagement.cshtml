@using UTB.Rusryl_Interaktivni_mapa_kasina.Domain.Entities
@model IList<Comment>

@{
    ViewData["Title"] = "Pin management";
}
<h1>@ViewData["Title"]</h1>

<a class ="btn btn-primary" asp-action="Create">Add Pin</a>

@{
    if(Model != null && Model.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">@nameof(Comment.Id)</th>
                    <th scope="col">@nameof(Comment.Content)</th>
                    <th scope="col">@nameof(Comment.DateAndTime)</th>
                    <th scope="col">@nameof(Comment.LocationId)</th>
                    <td scope="col">@nameof(Comment.UserId)</td>
                    <th scope="col">Delete</th>
                </tr>
            </thead>
            <tbody>
                @for(int i = 0; i < Model.Count; i++)
                {
                    Comment comment = Model[i];
                    <tr>
                        <th scope="row">@comment.Id</th>
                        <td>@comment.Content</td>
                        <td>@comment.DateAndTime</td>
                        <td>@comment.LocationId</td>
                        <td scope="col">@comment.UserId</td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@comment.Id" method="post">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>There are no locations!</p>
    }
}