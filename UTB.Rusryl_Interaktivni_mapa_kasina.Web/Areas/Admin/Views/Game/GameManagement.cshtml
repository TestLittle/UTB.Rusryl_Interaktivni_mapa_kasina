@using UTB.Rusryl_Interaktivni_mapa_kasina.Domain.Entities
@model IList<Game>

@{
    ViewData["Title"] = "Game management";
}
<h1>@ViewData["Title"]</h1>

<a class ="btn btn-primary" asp-action="Create">Add Game</a>

@{
    if(Model != null && Model.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">@nameof(Game.Id)</th>
                    <th scope="col">@nameof(Game.GameName)</th>
                    <th scope="col">Delete</th>
                </tr>
            </thead>
            <tbody>
                @for(int i = 0; i < Model.Count; i++)
                {
                    Game game = Model[i];
                    <tr>
                        <th scope="row">@game.Id</th>
                        <td>@game.GameName</td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@game.Id" method="post" onclick="return confirmDelete();">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>There are no games!</p>
    }

    @section Scripts
    {
        <script src="~/wwwroot/js/dialogs.js"></script>
    }
}