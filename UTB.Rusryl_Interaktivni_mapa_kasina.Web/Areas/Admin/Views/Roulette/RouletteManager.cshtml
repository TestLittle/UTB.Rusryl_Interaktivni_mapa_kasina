@model UTB.Rusryl_Interaktivni_mapa_kasina.Web.Areas.Admin.Controllers.RouletteTableViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Ruleta";
    var resultIndex = Model.ResultNumber.HasValue
        ? Array.IndexOf(UTB.Rusryl_Interaktivni_mapa_kasina.Web.Areas.Admin.Controllers.RouletteTableViewModel.WheelNumbers, Model.ResultNumber.Value)
        : -1;
    var rotation = resultIndex < 0 ? 0 : 6 * 360.0 - resultIndex * (360.0 / 37);
    var redNumbers = new HashSet<int> { 1, 3, 5, 7, 9, 12, 14, 16, 18, 19, 21, 23, 25, 27, 30, 32, 34, 36 };
    long ChipsOn(string betType) => Model.GetBetAmount(betType);
}

<style>
    .roulette-layout {
        display: grid;
        grid-template-columns: minmax(280px, 1fr) minmax(300px, 1fr);
        gap: 32px;
        align-items: center;
        max-width: 1000px;
        margin: 30px auto;
    }

    .wheel-area { display: flex; justify-content: center; padding: 24px; }
    .wheel-frame {
        position: relative;
        width: 340px;
        height: 340px;
        border: 12px solid #6d4c41;
        border-radius: 50%;
        background: radial-gradient(circle, #c8a96a 0 15%, #174d31 16% 100%);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3), inset 0 0 0 5px #d4af37;
    }

    .roulette-wheel {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        transform: rotate(0deg);
    }

    .roulette-wheel.spinning {
        animation: wheel-spin 5s cubic-bezier(0.12, 0.72, 0.12, 1) forwards;
    }

    @@keyframes wheel-spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(var(--rotation)); }
    }

    .wheel-number {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 30px;
        height: 30px;
        margin: -15px;
        border: 1px solid #d6bd7a;
        border-radius: 50%;
        color: white;
        font-size: 0.7rem;
        font-weight: 700;
        display: grid;
        place-items: center;
        transform: rotate(var(--angle)) translateY(-142px) rotate(var(--counter-angle));
    }

    .roulette-pointer {
        position: absolute;
        z-index: 2;
        top: -9px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        border-left: 13px solid transparent;
        border-right: 13px solid transparent;
        border-top: 25px solid #ffd54f;
        filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.5));
    }

    .roulette-center {
        position: absolute;
        z-index: 1;
        inset: 42%;
        border-radius: 50%;
        background: radial-gradient(circle, #f8e29a, #a67c28);
        border: 3px solid #f5d76e;
        box-shadow: 0 0 0 4px #174d31;
    }

    .result-number {
        display: inline-grid;
        min-width: 72px;
        height: 72px;
        padding: 0 10px;
        place-items: center;
        border: 4px solid #d4af37;
        border-radius: 12px;
        color: white;
        font-size: 2rem;
        font-weight: 700;
    }

    .roulette-red, .bet-red { background-color: #c62828; color: white; }
    .roulette-black, .bet-black { background-color: #212121; color: white; }
    .roulette-green, .bet-green { background-color: #16833b; color: white; }

    .betting-board { max-width: 800px; margin: 24px auto; }
    .number-betting-layout { display: grid; grid-template-columns: minmax(0, 1fr) 150px; gap: 8px; align-items: stretch; }
    .bet-number-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; }
    .bet-target {
        padding: 9px 4px;
        border: 1px solid #fff;
        border-radius: 4px;
        text-align: center;
        font-weight: 700;
        cursor: pointer;
    }
    .bet-target:hover { filter: brightness(1.2); }
    .bet-target.selected-bet { outline: 3px solid #d4af37; outline-offset: 1px; box-shadow: 0 0 10px rgba(212, 175, 55, 0.8); }
    .category-bet { background: #f1f1f1; color: #212121; border-color: #777; }
    .placed-chips { display: inline-block; margin-left: 4px; padding: 1px 5px; border-radius: 12px; background: #ffd54f; color: #212121; font-size: 0.75rem; }
    .zero-number { width: 100%; margin-bottom: 4px; }
    .outside-bets, .dozen-bets { display: grid; gap: 4px; margin-top: 6px; }
    .outside-bets { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .dozen-bets { grid-template-rows: repeat(3, minmax(0, 1fr)); }
    .dozen-bets .bet-target { display: flex; flex-direction: column; justify-content: center; }
    .bet-color-legend { display: flex; justify-content: center; gap: 8px; margin-top: 12px; }
    .bet-color-chip { padding: 6px 12px; border-radius: 4px; font-weight: 600; }
    @@media (max-width: 576px) {
        .number-betting-layout { grid-template-columns: minmax(0, 1fr) 105px; gap: 5px; }
        .outside-bets { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .bet-target { font-size: 0.85rem; }
    }

    @@media (max-width: 700px) {
        .roulette-layout { grid-template-columns: 1fr; gap: 8px; }
        .wheel-frame { width: 300px; height: 300px; }
        .wheel-number { transform: rotate(var(--angle)) translateY(-122px) rotate(var(--counter-angle)); }
    }

    @@media (max-width: 400px) {
        .number-betting-layout { grid-template-columns: 1fr; }
        .dozen-bets { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: none; }
    }
</style>

<h1 class="text-center">Ruleta evropská</h1>
<p class="text-center text-muted">Vyberte sázku, její hodnotu a roztočte kolo. Zelená nula vyhrává pouze při sázce přímo na 0.</p>

<form asp-area="Admin" asp-controller="Roulette" asp-action="PlaceBet" method="post">
<div class="roulette-layout">
    <div>
        <div class="wheel-area">
            <div class="wheel-frame" aria-label="Kolo evropské rulety">
                <div class="roulette-pointer" aria-hidden="true"></div>
                <div class="roulette-wheel @(Model.ResultNumber.HasValue ? "spinning" : string.Empty)" style="--rotation: @rotation.ToString("F4", CultureInfo.InvariantCulture)deg">
                    @for (var i = 0; i < UTB.Rusryl_Interaktivni_mapa_kasina.Web.Areas.Admin.Controllers.RouletteTableViewModel.WheelNumbers.Length; i++)
                    {
                        var number = UTB.Rusryl_Interaktivni_mapa_kasina.Web.Areas.Admin.Controllers.RouletteTableViewModel.WheelNumbers[i];
                        var angle = i * (360.0 / 37);
                        var color = UTB.Rusryl_Interaktivni_mapa_kasina.Web.Areas.Admin.Controllers.RouletteTableViewModel.GetNumberColor(number);
                        <span class="wheel-number roulette-@color" style="--angle: @angle.ToString("F4", CultureInfo.InvariantCulture)deg; --counter-angle: @((-angle).ToString("F4", CultureInfo.InvariantCulture))deg">@number</span>
                    }
                </div>
                <div class="roulette-center" aria-hidden="true"></div>
            </div>
        </div>
        <div class="text-center mt-2">
            @if (Model.ResultNumber.HasValue)
            {
                <div class="text-muted mb-2">Poslední výsledek</div>
                <span class="result-number roulette-@Model.ResultColor" role="status">@Model.ResultNumber</span>
                <strong class="ms-2">@(Model.ResultColor == "red" ? "červená" : Model.ResultColor == "black" ? "černá" : "zelená")</strong>
            }
            else
            {
                <span class="text-muted">Čeká se na první zatočení</span>
            }
        </div>
    </div>

    <div>
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h4">Sázka</h2>
                <p class="mb-2">Dostupné žetony: <strong>@Model.Balance</strong></p>
                <p class="mb-3">Na stole: <strong>@Model.TotalBetAmount</strong> žetonů</p>
                <div class="mb-3">
                    <label for="betAmount" class="form-label">Částka sázky v žetonech</label>
                    <input id="betAmount" name="betAmount" type="number" class="form-control" min="1" max="@Model.Balance" value="@Model.BetAmount" required />
                </div>
                <p class="mb-0">Zadejte částku a klikněte přímo na číslo nebo typ sázky níže. Zvýrazněná pozice označuje poslední sázku.</p>
            </div>
        </div>
    </div>
</div>

<div class="betting-board">
    <h2 class="h5 text-center">Sázková plocha — kliknutím položte žetony</h2>
    <button type="submit" name="betType" value="number:0" class="bet-target bet-green zero-number @(Model.SelectedBetType == "number:0" ? "selected-bet" : string.Empty)" disabled="@(Model.Balance < 1)">0 · zelená · 35:1 @if (ChipsOn("number:0") > 0) { <span class="placed-chips">@ChipsOn("number:0")</span> }</button>
    <div class="number-betting-layout">
        <div class="bet-number-grid">
            @for (var number = 1; number <= 36; number++)
            {
                var color = redNumbers.Contains(number) ? "red" : "black";
                var numberBet = $"number:{number}";
                <button type="submit" name="betType" value="@numberBet" class="bet-target bet-@color @(Model.SelectedBetType == numberBet ? "selected-bet" : string.Empty)" disabled="@(Model.Balance < 1)">@number @if (ChipsOn(numberBet) > 0) { <span class="placed-chips">@ChipsOn(numberBet)</span> }</button>
            }
        </div>
        <div class="dozen-bets">
        <button type="submit" name="betType" value="first12" class="bet-target category-bet @(Model.SelectedBetType == "first12" ? "selected-bet" : string.Empty)" disabled="@(Model.Balance < 1)">1–12 · 2:1 @if (ChipsOn("first12") > 0) { <span class="placed-chips">@ChipsOn("first12")</span> }</button>
        <button type="submit" name="betType" value="second12" class="bet-target category-bet @(Model.SelectedBetType == "second12" ? "selected-bet" : string.Empty)" disabled="@(Model.Balance < 1)">13–24 · 2:1 @if (ChipsOn("second12") > 0) { <span class="placed-chips">@ChipsOn("second12")</span> }</button>
        <button type="submit" name="betType" value="third12" class="bet-target category-bet @(Model.SelectedBetType == "third12" ? "selected-bet" : string.Empty)" disabled="@(Model.Balance < 1)">25–36 · 2:1 @if (ChipsOn("third12") > 0) { <span class="placed-chips">@ChipsOn("third12")</span> }</button>
        </div>
    </div>
    <div class="outside-bets">
        <button type="submit" name="betType" value="low" class="bet-target category-bet @(Model.SelectedBetType == "low" ? "selected-bet" : string.Empty)" disabled="@(Model.Balance < 1)">1–18 · 1:1 @if (ChipsOn("low") > 0) { <span class="placed-chips">@ChipsOn("low")</span> }</button>
        <button type="submit" name="betType" value="even" class="bet-target category-bet @(Model.SelectedBetType == "even" ? "selected-bet" : string.Empty)" disabled="@(Model.Balance < 1)">Sudá · 1:1 @if (ChipsOn("even") > 0) { <span class="placed-chips">@ChipsOn("even")</span> }</button>
        <button type="submit" name="betType" value="red" class="bet-target bet-red @(Model.SelectedBetType == "red" ? "selected-bet" : string.Empty)" disabled="@(Model.Balance < 1)">Červená · 1:1 @if (ChipsOn("red") > 0) { <span class="placed-chips">@ChipsOn("red")</span> }</button>
        <button type="submit" name="betType" value="black" class="bet-target bet-black @(Model.SelectedBetType == "black" ? "selected-bet" : string.Empty)" disabled="@(Model.Balance < 1)">Černá · 1:1 @if (ChipsOn("black") > 0) { <span class="placed-chips">@ChipsOn("black")</span> }</button>
        <button type="submit" name="betType" value="odd" class="bet-target category-bet @(Model.SelectedBetType == "odd" ? "selected-bet" : string.Empty)" disabled="@(Model.Balance < 1)">Lichá · 1:1 @if (ChipsOn("odd") > 0) { <span class="placed-chips">@ChipsOn("odd")</span> }</button>
        <button type="submit" name="betType" value="high" class="bet-target category-bet @(Model.SelectedBetType == "high" ? "selected-bet" : string.Empty)" disabled="@(Model.Balance < 1)">19–36 · 1:1 @if (ChipsOn("high") > 0) { <span class="placed-chips">@ChipsOn("high")</span> }</button>
    </div>
    <p class="small text-muted text-center mt-2 mb-0">Číslo: výplata 35:1 · tucet: 2:1 · ostatní sázky: 1:1. Nula netvoří součást žádné skupinové sázky.</p>
</div>
</form>

<div class="d-flex justify-content-center gap-2 mb-4">
    <form asp-area="Admin" asp-controller="Roulette" asp-action="Spin" method="post">
        <button type="submit" class="btn btn-primary btn-lg" disabled="@(Model.Bets.Count == 0)">Zatočit sázkami (@Model.TotalBetAmount žetonů)</button>
    </form>
    @if (Model.Bets.Count > 0)
    {
        <form asp-area="Admin" asp-controller="Roulette" asp-action="ClearBets" method="post">
            <button type="submit" class="btn btn-outline-warning">Vrátit sázky</button>
        </form>
    }
    <form asp-area="Admin" asp-controller="Roulette" asp-action="NewGame" method="post">
        <button type="submit" class="btn btn-outline-secondary">Resetovat hru (1000 žetonů)</button>
    </form>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert @(Model.IsWin ? "alert-success" : Model.ResultNumber.HasValue ? "alert-secondary" : "alert-warning") text-center" role="status">@Model.Message</div>
}

