@model UTB.Rusryl_Interaktivni_mapa_kasina.Web.Areas.Admin.Controllers.PokerTableViewModel

@{
    ViewData["Title"] = "Texas Hold'em";

    // Pomocné funkce pro převod barvy karty na symbol a CSS třídu
    string GetSuitSymbol(string suit) => suit?.ToLower() switch
    {
        "hearts" => "♥",
        "diamonds" => "♦",
        "clubs" => "♣",
        "spades" => "♠",
        _ => ""
    };

    string GetSuitColorClass(string suit) => (suit?.ToLower() == "hearts" || suit?.ToLower() == "diamonds")
        ? "card-red"
        : "card-black";
}

<style>
    .poker-table {
        background: radial-gradient(circle, #2e7d32 0%, #1b5e20 100%);
        border: 14px solid #4e342e;
        border-radius: 150px;
        padding: 40px 20px;
        max-width: 800px;
        margin: 30px auto;
        box-shadow: 0 15px 35px rgba(0,0,0,0.5), inset 0 0 40px rgba(0,0,0,0.4);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 50px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .board-section {
        text-align: center;
    }

    .section-label {
        color: rgba(255, 255, 255, 0.75);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 12px;
        font-weight: 600;
    }

    .cards-row {
        display: flex;
        gap: 12px;
        justify-content: center;
        min-height: 120px;
    }

    /* Vzhled karty */
    .playing-card {
        width: 80px;
        height: 115px;
        background-color: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 8px;
        user-select: none;
        transition: transform 0.2s ease;
    }

    .playing-card:hover {
        transform: translateY(-5px);
    }

    .card-red { color: #d32f2f; }
    .card-black { color: #212121; }

    .card-corner {
        font-size: 1.1rem;
        font-weight: bold;
        line-height: 1;
        text-align: left;
    }

    .card-corner.bottom {
        transform: rotate(180deg);
    }

    .card-center {
        font-size: 2.2rem;
        text-align: center;
        line-height: 1;
    }

    /* Rub karty (skrytá karta) */
    .card-back {
        background: repeating-linear-gradient(
            45deg,
            #1565c0,
            #1565c0 10px,
            #0d47a1 10px,
            #0d47a1 20px
        );
        border: 3px solid #ffffff;
    }

    /* Prázdný slot na stole (nevytažená karta) */
    .card-placeholder {
        width: 80px;
        height: 115px;
        border: 2px dashed rgba(255, 255, 255, 0.3);
        border-radius: 8px;
    }

    @@media (max-width: 576px) {
        .poker-table {
            border-width: 8px;
            border-radius: 48px;
            padding: 32px 10px;
            gap: 32px;
        }

        .cards-row {
            gap: 6px;
        }

        .playing-card,
        .card-placeholder {
            width: 54px;
            height: 78px;
        }

        .playing-card {
            padding: 5px;
        }

        .card-corner {
            font-size: 0.8rem;
        }

        .card-center {
            font-size: 1.5rem;
        }
    }
</style>

<h1 class="text-center">Texas Hold'em</h1>
<p class="text-center text-muted">Hráč má dvě vlastní karty. Dealer postupně rozdává až pět společných karet na stůl.</p>
<p class="text-center"><strong>Kolo: @Model.RoundName</strong></p>

<div class="poker-table">
    <div class="board-section">
        <div class="section-label">Společné karty (rozdává dealer)</div>
        <div class="cards-row">
            @for (int i = 0; i < 5; i++)
            {
                if (Model.CommunityCards != null && i < Model.CommunityCards.Count)
                {
                    var card = Model.CommunityCards[i];
                    if (card.IsFaceUp)
                    {
                        <div class="playing-card @GetSuitColorClass(card.Suit)" role="img" aria-label="@card.Value @card.Suit">
                            <div class="card-corner">@card.Value<br />@GetSuitSymbol(card.Suit)</div>
                            <div class="card-center">@GetSuitSymbol(card.Suit)</div>
                            <div class="card-corner bottom">@card.Value<br />@GetSuitSymbol(card.Suit)</div>
                        </div>
                    }
                    else
                    {
                        <div class="playing-card card-back" role="img" aria-label="Skrytá karta"></div>
                    }
                }
                else
                {
                    <div class="card-placeholder" aria-hidden="true"></div>
                }
            }
        </div>
    </div>

    <div class="board-section">
        <div class="section-label">Tvoje karty (2)</div>
        <div class="cards-row">
            @if (Model.PlayerCards != null)
            {
                foreach (var card in Model.PlayerCards)
                {
                    if (card.IsFaceUp)
                    {
                        <div class="playing-card @GetSuitColorClass(card.Suit)" role="img" aria-label="@card.Value @card.Suit">
                            <div class="card-corner">@card.Value<br />@GetSuitSymbol(card.Suit)</div>
                            <div class="card-center">@GetSuitSymbol(card.Suit)</div>
                            <div class="card-corner bottom">@card.Value<br />@GetSuitSymbol(card.Suit)</div>
                        </div>
                    }
                    else
                    {
                        <div class="playing-card card-back" role="img" aria-label="Skrytá karta"></div>
                    }
                }
            }
        </div>
    </div>
</div>

<div class="d-flex justify-content-center gap-2 mb-4">
    @if (Model.CanContinue)
    {
        <form asp-area="Admin" asp-controller="Poker" asp-action="Continue" method="post">
            <button type="submit" class="btn btn-primary">@Model.NextActionText</button>
        </form>
    }
    else
    {
        <span class="align-self-center fw-bold">Všechny společné karty jsou odkryté.</span>
    }
    <form asp-area="Admin" asp-controller="Poker" asp-action="NewGame" method="post">
        <button type="submit" class="btn btn-secondary">Nová hra</button>
    </form>
</div>
