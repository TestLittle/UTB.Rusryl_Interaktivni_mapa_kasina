@using UTB.Rusryl_Interaktivni_mapa_kasina.Domain.Entities
@model IList<Location>

@{
    ViewData["Title"] = "Pin management";
}
<h1>@ViewData["Title"]</h1>

<a class ="btn btn-primary" asp-action="Create">Add Pin</a>

@{
    if(Model != null && Model.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">@nameof(Location.Id)</th>
                    <th scope="col">@nameof(Location.Name)</th>
                    <th scope="col">@nameof(Location.Address)</th>
                    <th scope="col">@nameof(Location.ImageSrc)</th>
                    <td scope="col">@nameof(Location.LocationTypeId)</td>
                    <td scope="col">@nameof(Location.LocationKindId)</td>
                    <th scope="col">Delete</th>
                </tr>
            </thead>
            <tbody>
                @for(int i = 0; i < Model.Count; i++)
                {
                    Location location = Model[i];
                    <tr>
                        <th scope="row">@location.Id</th>
                        <td>@location.Name</td>
                        <td>@location.Address</td>
                        <td>@location.ImageSrc</td>
                        <td scope="col">@location.LocationTypeId</td>
                        <td scope="col">@location.LocationKindId</td>
                        <td><a class="btn btn-primary" asp-action="Edit" asp-route-id="@location.Id">Edit</a></td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@location.Id" method="post">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>There are no locations!</p>
    }
}