@using UTB.Rusryl_Interaktivni_mapa_kasina.Domain.Entities
@model IList<Location>

@{
    ViewData["Title"] = "Pin management";
}
<h1>@ViewData["Title"]</h1>

<a asp-action="Create">Create Product</a>

@{
    if(Model != null && Model.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">@nameof(Location.Id)</th>
                    <th scope="col">@nameof(Location.Name)</th>
                    <th scope="col">@nameof(Location.Address)</th>
                    <th scope="col">@nameof(Location.ImageSrc)</th>
                    <th scope="col">@nameof(Location.LocationType)</th>
                    <th scope="col">@nameof(Location.LocationKind)</th>
                </tr>
            </thead>
            <tbody>
                @for(int i = 0; i < Model.Count; i++)
                {
                    Location location = Model[i];
                    <tr>
                        <th scope="row">@location.Id</th>
                        <td>@location.Name</td>
                        <td>@location.Address</td>
                        <td>@location.ImageSrc</td>
                        <td>@location.LocationType</td>
                        <td>@location.LocationKind</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>There are no locations!</p>
    }
}