@using UTB.Rusryl_Interaktivni_mapa_kasina.Domain.Entities
@model Comment

@{
    ViewData["Title"] = "Create New Comment";
}
<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label" asp-for="Content"></label>
        <input class="form-control" asp-for="Content">
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="LocationId"></label>
        <input class="form-control" asp-for="LocationId">
    </div>
    <button type="submit" class="btn btn-success">Submit</button>
    <a asp-action="CommentManagement" class="btn btn-danger">Cancel</a>
</form>