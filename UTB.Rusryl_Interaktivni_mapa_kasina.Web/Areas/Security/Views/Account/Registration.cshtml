@using UTB.Rusryl_Interaktivni_mapa_kasina.Application.ViewModels
@model RegistrationViewModel
@{
    ViewData["Title"] = "Create a new account";
}

<div id="registration-login-form">
    <form asp-for="Registration" method="post" class="form-signup">

        <h1 class="h3 mb-3 font-weight-normal" style="text-align: center">Registration</h1>
        <div asp-validation-summary="All" class="text-danger"></div>

        <input asp-for="FirstName" type="text" id="firstName" class="form-control" placeholder="First Name" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
        
        <input asp-for="LastName" type="text" id="lastname" class="form-control" placeholder="Last Name" />
        <span asp-validation-for="LastName" class="text-danger"></span>

        <input asp-for="Address" type="text" id="address" class="form-control" placeholder="Address" />
        <span asp-validation-for="Address" class="text-danger"></span>

        <input asp-for="City" type="text" id="city" class="form-control" placeholder="City" />
        <span asp-validation-for="City" class="text-danger"></span>

        <input asp-for="ZipCode" type="text" id="zipcode" class="form-control" placeholder="Zip Code" />
        <span asp-validation-for="ZipCode" class="text-danger"></span>

        <input asp-for="Country" type="text" id="country" class="form-control" placeholder="Country" />
        <span asp-validation-for="Country" class="text-danger"></span>

        <input asp-for="Username" type="text" id="username" class="form-control" placeholder="Username" />
        <span asp-validation-for="Username" class="text-danger"></span>

        <input asp-for="Email" type="email" id="email" class="form-control" placeholder="Email" />
        <span asp-validation-for="Email" class="text-danger"></span>

        <input asp-for="Password" type="password" id="password" class="form-control" placeholder="Password" />
        <span asp-validation-for="Password" class="text-danger"></span>

        <input asp-for="RepeatedPassword" type="password" id="repeat-password" class="form-control" placeholder="Repeat Password" />
        <span asp-validation-for="RepeatedPassword" class="text-danger"></span>

        <br />
        <hr />
        <a asp-action="Login" class="btn btn-secondary btn-block text-white" type="button" id="btnLogIn">Already have an account? Log In</a>
    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}