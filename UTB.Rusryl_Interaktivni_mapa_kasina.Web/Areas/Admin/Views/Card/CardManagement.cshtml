@using UTB.Rusryl_Interaktivni_mapa_kasina.Domain.Entities
@model IList<Card>

@{
    ViewData["Title"] = "Card management";
}
<h1>@ViewData["Title"]</h1>

<a class ="btn btn-primary" asp-action="Create">Add Card</a>

@{
    if(Model != null && Model.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">@nameof(Card.Id)</th>
                    <th scope="col">@nameof(Card.CardNumber)</th>
                    <th scope="col">@nameof(Card.ExpirationDate)</th>
                    <th scope="col">@nameof(Card.SecurityCode)</th>
                    <th scope="col">@nameof(Card.CardTypeId)</th>
                    <th scope="col">Delete</th>
                </tr>
            </thead>
            <tbody>
                @for(int i = 0; i < Model.Count; i++)
                {
                    Card card = Model[i];
                    <tr>
                        <th scope="row">@card.Id</th>
                        <td>@card.CardNumber</td>
                        <td>@card.ExpirationDate</td>
                        <td>@card.SecurityCode</td>
                        <td scope="col">@card.CardTypeId</td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@card.Id" method="post">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>There are no cards!</p>
    }
}